{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "Watches JS source files, config, and package files. When any change, asks the agent to update the README or /docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.js",
      "**/*.json",
      "**/*.env",
      "**/*.config.js",
      "**/package.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and update the documentation accordingly — either the README.md in the root or any relevant files in the /docs folder if it exists. Keep the docs accurate and in sync with the current state of the code."
  }
}